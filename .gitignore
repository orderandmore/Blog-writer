# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.*.local

# portal data (runtime caches — legacy SQLite, scratch image refs, etc.)
# but voice-samples.json is checked-in content the prompt loader reads.
# Negation only works if the parent directory itself isn't excluded — use
# data/* not /data/ so individual files can be re-included.
data/*
!data/voice-samples.json

# Local scratch directory for source images you're feeding to the wizard.
# Keep these off GitHub — they're personal photos, not source code.
/images/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
